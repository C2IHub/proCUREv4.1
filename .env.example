# AWS Bedrock Configuration for proCURE Platform

# AWS Account Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Alternative: Use AWS profile (recommended for development)
# AWS_PROFILE=proCURE-dev

# Strands Agent API Endpoints (deployed Lambda functions via API Gateway)
# These are the endpoints for the deployed Strands agents
# Leave empty to use mock implementations during development
COMPLIANCE_MONITOR_API_ENDPOINT=
RISK_PREDICTOR_API_ENDPOINT=
DOCUMENT_INTELLIGENCE_API_ENDPOINT=

# Production Bedrock Agent Configuration
# Replace these with actual agent IDs from AWS Console after agent creation
BEDROCK_COMPLIANCE_AGENT_ID=XXXXXXXXXX
BEDROCK_COMPLIANCE_AGENT_ALIAS_ID=TSTALIASID

BEDROCK_RISK_AGENT_ID=YYYYYYYYYY
BEDROCK_RISK_AGENT_ALIAS_ID=TSTALIASID

BEDROCK_DOCUMENT_AGENT_ID=ZZZZZZZZZZ
BEDROCK_DOCUMENT_AGENT_ALIAS_ID=TSTALIASID

# Strands Agent Configuration (for Lambda functions)
# These are used by the deployed Lambda functions
COMPLIANCE_MONITOR_AGENT_ID=XXXXXXXXXX
COMPLIANCE_MONITOR_AGENT_ALIAS_ID=TSTALIASID

RISK_PREDICTOR_AGENT_ID=YYYYYYYYYY
RISK_PREDICTOR_AGENT_ALIAS_ID=TSTALIASID

DOCUMENT_INTELLIGENCE_AGENT_ID=ZZZZZZZZZZ
DOCUMENT_INTELLIGENCE_AGENT_ALIAS_ID=TSTALIASID

# Agent Configuration
BEDROCK_ENABLED=true
BEDROCK_FALLBACK_TO_MOCK=true

# Model Configuration (for fallback scenarios)
BEDROCK_PRIMARY_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_FALLBACK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Performance Configuration
BEDROCK_TIMEOUT=60000
BEDROCK_MAX_RETRIES=3
BEDROCK_CACHE_TTL=300

# Monitoring and Logging
CLOUDWATCH_LOG_GROUP=/aws/bedrock/proCURE
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DEBUG_LOGGING=false

# Application Configuration
NODE_ENV=production

# Rate Limiting (requests per minute)
COMPLIANCE_AGENT_RATE_LIMIT=30
RISK_AGENT_RATE_LIMIT=20
DOCUMENT_AGENT_RATE_LIMIT=40

# Session Configuration
SESSION_TIMEOUT=1800
ENABLE_SESSION_MEMORY=true

# Cost Optimization
ENABLE_RESPONSE_CACHING=true
CACHE_DURATION=300
TOKEN_USAGE_ALERTS=true
MONTHLY_COST_LIMIT=500