{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:integration": "ts-node tests/bedrock-integration.test.ts",
    "test:bedrock": "ts-node tests/bedrock-integration.test.ts",
    "validate:agent-cards": "node scripts/validate-agent-cards.js",
    "deploy:strands": "./scripts/deploy-strands-agents.sh deploy",
    "validate:strands": "./scripts/deploy-strands-agents.sh validate",
    "build:strands": "npm run build:strands:compliance && npm run build:strands:risk && npm run build:strands:document",
    "build:strands:compliance": "cd agents/strands/compliance-monitor && npm install && npm run build",
    "build:strands:risk": "cd agents/strands/risk-predictor && npm install && npm run build", 
    "build:strands:document": "cd agents/strands/document-intelligence && npm install && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.844.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.844.0",
    "@aws-sdk/client-bedrock-runtime": "^3.844.0",
    "@tanstack/react-query": "^5.83.0",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.0.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
